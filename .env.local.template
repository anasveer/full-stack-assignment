# =====================================================
# Kontrora ENVIRONMENT CONFIGURATION
# =====================================================
# Uses Supabase Cloud (no Docker required)
#
# SETUP:
#   1. cp .env.local.template .env.local
#   2. Fill in Supabase credentials below (Settings → API)
#   3. Apply supabase/schema.sql then supabase/seed-roles.sql
#   4. npm run seed:users
#   5. npm run dev
#   6. cd escrow-service && go run ./cmd/server

# =====================================================
# SUPABASE (CLOUD) — required
# =====================================================
# Project URL + publishable (anon) key + service_role key
# https://supabase.com/dashboard → your project → Settings → API
# NEVER commit real credentials. This file is a template only.
# If a service_role key was ever committed, rotate it in the dashboard.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-never-commit-this
# =====================================================
# APP SETTINGS
# =====================================================

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
LOG_LEVEL=debug
NODE_ENV=development

# Role-select login on /login works after `npm run seed:users`.
# Set true only if you also want destructive actions blocked in the API.
NEXT_PUBLIC_DEMO_MODE=false

# =====================================================
# SECURITY (optional for local assignment)
# =====================================================

# SETUP_SECRET=change-me-to-something-secure
# CRON_SECRET=change-me-to-something-secure

# =====================================================
# SMTP (optional)
# =====================================================
# SMTP_HOST=smtp.your-domain.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# SMTP_FROM=Kontrora <noreply@your-domain.com>

# =====================================================
# OPTIONAL: RATE LIMITING
# =====================================================
# UPSTASH_REDIS_REST_URL=your_upstash_redis_url
# UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token
# ENABLE_RATE_LIMIT=true

# =====================================================
# GO ESCROW SERVICE
# =====================================================
GO_ESCROW_SERVICE_URL=http://localhost:4001
